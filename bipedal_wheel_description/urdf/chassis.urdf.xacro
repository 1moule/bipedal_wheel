<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- https://upload.wikimedia.org/wikipedia/commons/5/52/Wheelbase_and_Track.png -->
    <xacro:property name="leg_x_offset" value="0.0"/>
    <xacro:property name="leg_y_offset" value="0.178"/>
    <xacro:property name="leg_z_offset" value="0.038"/>
    <xacro:property name="leg_pitch_offset" value="${pi/2}"/>
    <xacro:property name="second_leg_y_offset" value="0.018"/>
    <xacro:property name="wheel_radius" value="0.055"/>
    <xacro:property name="wheel_y_offset" value="0.05"/>
    <xacro:property name="wheel_z_offset" value="-0.26"/>
    <xacro:property name="wheel_joint_effort" value="5"/>
    <xacro:property name="wheel_joint_velocity" value="50"/>

    <xacro:include filename="$(find bipedal_wheel_description)/urdf/leg.urdf.xacro"/>
    <xacro:include filename="$(find bipedal_wheel_description)/urdf/leg.transmission.xacro"/>

    <xacro:macro name="guide_wheel" params="connected_to prefix x_offset y_offset z_offset">
        <link name="${prefix}_guide_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder length="0.01" radius="0.02"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2}  0 0"/>
                <geometry>
                    <cylinder length="0.01" radius="0.02"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.05"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="5.417e-6" ixy="0.0" ixz="0.0" iyy="1.0e-5" iyz="0.0" izz="5.417e-6"/>
            </inertial>
        </link>
        <joint name="${prefix}_guide_wheel_joint" type="revolute">
            <parent link="${connected_to}"/>
            <child link="${prefix}_guide_wheel"/>
            <origin xyz="${x_offset} ${y_offset} ${z_offset}" rpy="0 0 0"/>
            <limit effort="0." velocity="99" lower="-1e16" upper="1e16"/>
            <dynamics damping="0.0" friction="0.05"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="wheel"
                 params="connected_to prefix wheel_x_offset wheel_y_offset wheel_z_offset  mechanical_reduction">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://bipedal_wheel_description/meshes/wheel.stl"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2}  0 0"/>
                <geometry>
                    <cylinder length="0.03" radius="${wheel_radius}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.803567"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="1.752e-3" ixy="-2.766e-6" ixz="-1.599e-6" iyy="3.357e-3"
                         iyz="2.581e-6" izz="1.752e-3"/>
            </inertial>
        </link>
        <joint name="${prefix}_wheel_joint" type="revolute">
            <axis xyz="0 1 0"/>
            <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
            <parent link="${connected_to}"/>
            <child link="${prefix}_wheel"/>
            <dynamics damping="0.0" friction="0.08"/>
            <limit effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}" lower="-1e16" upper="1e16"/>
        </joint>
        <transmission name="${prefix}_wheel_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <actuator name="${prefix}_wheel_joint_motor">
                <mechanicalReduction>${mechanical_reduction}</mechanicalReduction>
            </actuator>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
        </transmission>
    </xacro:macro>

    <xacro:macro name="chassis" params="use_simulation add_wheel">
        <link name="base_link">
            <inertial>
                <mass value="11.70"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.085" ixy="0.0" ixz="0.0" iyy="0.085" iyz="0.0" izz="0.132"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.14" radius="0.15"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0.0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.14" radius="0.15"/>
                </geometry>
            </collision>
        </link>

        <xacro:leg prefix="left" connected_to="base_link" pitch_offset="${leg_pitch_offset}"
                   leg_x_offset="${leg_x_offset}"
                   leg_y_offset="${leg_y_offset}"
                   leg_z_offset="${leg_z_offset}"
                   second_leg_y_offset="${second_leg_y_offset}"/>
        <xacro:leg prefix="right" connected_to="base_link" pitch_offset="${leg_pitch_offset}"
                   leg_x_offset="${leg_x_offset}"
                   leg_y_offset="-${leg_y_offset}"
                   leg_z_offset="${leg_z_offset}"
                   second_leg_y_offset="-${second_leg_y_offset}"/>

        <xacro:leg_transmission prefix="left" mechanical_reduction="-1"/>
        <xacro:leg_transmission prefix="right" mechanical_reduction="1"/>

        <xacro:if value="${add_wheel}">
            <xacro:wheel connected_to="left_calf" prefix="left" wheel_x_offset="0"
                         wheel_y_offset="${wheel_y_offset}"
                         wheel_z_offset="${wheel_z_offset}" mechanical_reduction="-19.2032"/>
            <xacro:wheel connected_to="right_calf" prefix="right" wheel_x_offset="0"
                         wheel_y_offset="${-wheel_y_offset}"
                         wheel_z_offset="${wheel_z_offset}" mechanical_reduction="19.2032"/>
        </xacro:if>

        <xacro:guide_wheel connected_to="base_link" prefix="left_front" x_offset="0.16" y_offset="0.08"
                           z_offset="-0.07"/>
        <xacro:guide_wheel connected_to="base_link" prefix="right_front" x_offset="0.16" y_offset="-0.08"
                           z_offset="-0.07"/>
        <xacro:guide_wheel connected_to="base_link" prefix="left_back" x_offset="-0.16" y_offset="0.08"
                           z_offset="-0.07"/>
        <xacro:guide_wheel connected_to="base_link" prefix="right_back" x_offset="-0.16" y_offset="-0.08"
                           z_offset="-0.07"/>

        <!--        <xacro:guide_wheel connected_to="left_calf" prefix="left_calf" x_offset="-0.01" y_offset="0.02"-->
        <!--                           z_offset="0.07"/>-->
        <!--        <xacro:guide_wheel connected_to="right_calf" prefix="right_calf" x_offset="-0.01" y_offset="-0.02"-->
        <!--                           z_offset="0.07"/>-->

    </xacro:macro>

</robot>
