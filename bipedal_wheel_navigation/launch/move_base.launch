<launch>
    <!-- Arguments -->
    <arg name="odom_topic" default="odom"/>

    <!-- move_base -->
    <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
        <rosparam file="$(find bipedal_wheel_navigation)/param/costmap_common_params_burger.yaml" command="load"
                  ns="global_costmap"/>
        <rosparam file="$(find bipedal_wheel_navigation)/param/costmap_common_params_burger.yaml" command="load"
                  ns="local_costmap"/>
        <rosparam file="$(find bipedal_wheel_navigation)/param/local_costmap_params.yaml" command="load"/>
        <rosparam file="$(find bipedal_wheel_navigation)/param/global_costmap_params.yaml" command="load"/>
        <rosparam file="$(find bipedal_wheel_navigation)/param/move_base_params.yaml" command="load"/>
        <remap from="odom" to="$(arg odom_topic)"/>
    </node>
</launch>
